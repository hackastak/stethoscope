# --- Stethoscope environment ---
# Copy to `.env` and fill in. NEVER commit real secrets — .env is git-ignored.

# GitHub read-only Personal Access Token (public_repo scope, or none for public data).
# Whoever runs the app supplies their own token; it is never baked into the repo.
GITHUB_TOKEN=ghp_your_read_only_token_here

# Anthropic API key for the LLM narrative endpoint.
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Anthropic model id used for the narrative synthesis.
LLM_MODEL=claude-sonnet-5

# HTTP server port.
PORT=3000

# Path to the SQLite database file (git-ignored).
DATABASE_PATH=./stethoscope.sqlite

# --- Metric thresholds (defaults are conservative to minimize false positives) ---

# Approvals faster than this (seconds) count toward rubber-stamp detection.
FAST_APPROVAL_SECONDS=300

# Minimum PR size (additions + deletions) for rubber-stamp eligibility.
MIN_PR_SIZE=100

# Minimum forward review count before a one-directional reciprocity edge is flagged.
MIN_RECIPROCITY_INTERACTIONS=3
